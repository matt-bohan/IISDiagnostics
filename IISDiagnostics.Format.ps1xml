<?xml version="1.0" encoding="utf-8"?>
<!--
  IISDiagnostics_Format.ps1xml
  Complete format file: StatusHelp (existing) + HttpErrEntry + HttpErrSummary
-->
<Configuration>
  <ViewDefinitions>

    <!-- ================================================================
         IISDiagnostics.StatusHelp  (existing views, unchanged)
         ================================================================ -->
    <View>
      <Name>IISDiagnostics.StatusHelp</Name>
      <ViewSelectedBy>
        <TypeName>IISDiagnostics.StatusHelp</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <Label>Status code</Label>
                <PropertyName>StatusCode</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Title</Label>
                <PropertyName>Title</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Description</Label>
                <PropertyName>Description</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Server admin concern</Label>
                <PropertyName>ServerAdminConcern</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Application support concern</Label>
                <PropertyName>ApplicationSupportConcern</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Likely causes</Label>
                <PropertyName>LikelyCausesDisplay</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Things to check</Label>
                <PropertyName>ChecksDisplay</PropertyName>
              </ListItem>
              <ListItem>
                <Label>See also</Label>
                <PropertyName>SeeAlsoDisplay</PropertyName>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

    <View>
      <Name>IISDiagnostics.StatusHelp.Table</Name>
      <ViewSelectedBy>
        <TypeName>IISDiagnostics.StatusHelp</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Code</Label>
            <Width>10</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Title</Label>
            <Width>48</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Server admin</Label>
            <Width>26</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>App support</Label>
            <Width>26</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>StatusCode</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Title</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>ServerAdminConcern</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>ApplicationSupportConcern</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <!-- ================================================================
         IISDiagnostics.HttpErrEntry
         Default: table showing the four fields you want at a glance
         during triage. Timestamp, Reason, Method, StatusCode, Uri, ClientIp.
         ================================================================ -->
    <View>
      <Name>IISDiagnostics.HttpErrEntry</Name>
      <ViewSelectedBy>
        <TypeName>IISDiagnostics.HttpErrEntry</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Timestamp</Label>
            <Width>21</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Port</Label>
            <Width>6</Width>
            <Alignment>Right</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Reason</Label>
            <Width>28</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>SC</Label>
            <Width>4</Width>
            <Alignment>Right</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Method</Label>
            <Width>8</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Uri</Label>
            <Width>40</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>ClientIp</Label>
            <Width>16</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <ScriptBlock>
                  if ($_.Timestamp) { $_.Timestamp.ToString('dd/MM/yyyy HH:mm:ss') } else { '-' }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($_.ServerPort) { $_.ServerPort } else { '-' }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Reason</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($_.StatusCode) { $_.StatusCode } else { '-' }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($_.Method) { $_.Method } else { '-' }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Uri</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>ClientIp</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <!-- Detail list for a single HttpErrEntry (Format-List or single result) -->
    <View>
      <Name>IISDiagnostics.HttpErrEntry.Detail</Name>
      <ViewSelectedBy>
        <TypeName>IISDiagnostics.HttpErrEntry</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <Label>Timestamp (local)</Label>
                <ScriptBlock>
                  if ($_.Timestamp) { $_.Timestamp.ToString('dd/MM/yyyy HH:mm:ss') } else { '-' }
                </ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Reason</Label>
                <PropertyName>Reason</PropertyName>
              </ListItem>
              <ListItem>
                <Label>What it means</Label>
                <PropertyName>ReasonDescription</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Status code</Label>
                <ScriptBlock>
                  if ($_.StatusCode) { $_.StatusCode } else { '— (HTTP.sys dropped before status was set)' }
                </ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Method</Label>
                <ScriptBlock>if ($_.Method) { $_.Method } else { '-' }</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>URI</Label>
                <ScriptBlock>if ($_.Uri) { $_.Uri } else { '-' }</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Client</Label>
                <ScriptBlock>
                  '{0}:{1}' -f ($_.ClientIp ?? '-'), ($_.ClientPort ?? '-')
                </ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Server</Label>
                <ScriptBlock>
                  '{0}:{1}' -f ($_.ServerIp ?? '-'), ($_.ServerPort ?? '-')
                </ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>HTTP version</Label>
                <ScriptBlock>if ($_.HttpVersion) { $_.HttpVersion } else { '-' }</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>IIS site ID</Label>
                <ScriptBlock>if ($_.SiteId) { $_.SiteId } else { '-' }</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Queue name</Label>
                <ScriptBlock>if ($_.QueueName) { $_.QueueName } else { '-' }</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Source file</Label>
                <PropertyName>SourceFile</PropertyName>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

    <!-- ================================================================
         IISDiagnostics.HttpErrSummary
         List view: overview header, then the pre-rendered display strings.
         ================================================================ -->
    <View>
      <Name>IISDiagnostics.HttpErrSummary</Name>
      <ViewSelectedBy>
        <TypeName>IISDiagnostics.HttpErrSummary</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <Label>Window start</Label>
                <ScriptBlock>$_.StartTime.ToString('dd/MM/yyyy HH:mm:ss')</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Window end</Label>
                <ScriptBlock>$_.EndTime.ToString('dd/MM/yyyy HH:mm:ss')</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Log files scanned</Label>
                <PropertyName>LogFilesScanned</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Total entries</Label>
                <PropertyName>TotalEntries</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Earliest entry</Label>
                <ScriptBlock>
                  if ($_.EarliestEntry) { $_.EarliestEntry.ToString('dd/MM/yyyy HH:mm:ss') } else { '-' }
                </ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Latest entry</Label>
                <ScriptBlock>
                  if ($_.LatestEntry) { $_.LatestEntry.ToString('dd/MM/yyyy HH:mm:ss') } else { '-' }
                </ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Reason breakdown</Label>
                <PropertyName>ReasonBreakdownDisplay</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Top client IPs</Label>
                <PropertyName>TopClientsDisplay</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Top URIs</Label>
                <PropertyName>TopUrisDisplay</PropertyName>
              </ListItem>
              <ListItem>
                <Label>By server port</Label>
                <PropertyName>PortBreakdownDisplay</PropertyName>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

    <!-- ================================================================
         IISDiagnostics.W3CStatusGroup
         Default table: one row per status combination — the at-a-glance view.
         Detail list: full enrichment including causes, checks, top URIs.
         ================================================================ -->
    <View>
      <Name>IISDiagnostics.W3CStatusGroup</Name>
      <ViewSelectedBy>
        <TypeName>IISDiagnostics.W3CStatusGroup</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>StatusKey</Label><Width>11</Width><Alignment>Left</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Count</Label><Width>8</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Pct</Label><Width>7</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Known</Label><Width>6</Width><Alignment>Left</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Title</Label><Width>55</Width><Alignment>Left</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>FirstSeen</Label><Width>9</Width><Alignment>Left</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>LastSeen</Label><Width>9</Width><Alignment>Left</Alignment></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>StatusKey</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Count</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>"$($_.Percent)%"</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.IsKnown) { 'Yes' } else { '?' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Title) { $_.Title } else { '(not in data file)' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.FirstSeen) { $_.FirstSeen.ToString('HH:mm:ss') } else { '-' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.LastSeen) { $_.LastSeen.ToString('HH:mm:ss') } else { '-' }</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>IISDiagnostics.W3CStatusGroup.Detail</Name>
      <ViewSelectedBy>
        <TypeName>IISDiagnostics.W3CStatusGroup</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><Label>Status key</Label><PropertyName>StatusKey</PropertyName></ListItem>
              <ListItem><Label>Status code</Label><PropertyName>StatusCode</PropertyName></ListItem>
              <ListItem><Label>Substatus</Label><PropertyName>SubStatus</PropertyName></ListItem>
              <ListItem><Label>Count</Label><PropertyName>Count</PropertyName></ListItem>
              <ListItem><Label>Percent of total</Label><ScriptBlock>"$($_.Percent)%"</ScriptBlock></ListItem>
              <ListItem><Label>First seen</Label><ScriptBlock>if ($_.FirstSeen) { $_.FirstSeen.ToString('dd/MM/yyyy HH:mm:ss') } else { '-' }</ScriptBlock></ListItem>
              <ListItem><Label>Last seen</Label><ScriptBlock>if ($_.LastSeen) { $_.LastSeen.ToString('dd/MM/yyyy HH:mm:ss') } else { '-' }</ScriptBlock></ListItem>
              <ListItem>
                <Label>In data file</Label>
                <ScriptBlock>
                  if ($_.IsKnown) {
                      "Yes ($($_.LookupSource))"
                  } else {
                      "No — run: Get-IISStatusHelp '$($_.StatusKey)' for further guidance"
                  }
                </ScriptBlock>
              </ListItem>
              <ListItem><Label>Title</Label><ScriptBlock>if ($_.Title) { $_.Title } else { '(not documented)' }</ScriptBlock></ListItem>
              <ListItem><Label>Description</Label><ScriptBlock>if ($_.Description) { $_.Description } else { '—' }</ScriptBlock></ListItem>
              <ListItem><Label>Server admin concern</Label><ScriptBlock>if ($_.ServerAdminConcern) { $_.ServerAdminConcern } else { '—' }</ScriptBlock></ListItem>
              <ListItem><Label>App support concern</Label><ScriptBlock>if ($_.ApplicationSupportConcern) { $_.ApplicationSupportConcern } else { '—' }</ScriptBlock></ListItem>
              <ListItem><Label>Likely causes</Label><PropertyName>LikelyCausesDisplay</PropertyName></ListItem>
              <ListItem><Label>Things to check</Label><PropertyName>ChecksDisplay</PropertyName></ListItem>
              <ListItem><Label>Top URIs</Label><PropertyName>TopUrisDisplay</PropertyName></ListItem>
              <ListItem><Label>Top clients</Label><PropertyName>TopClientsDisplay</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

    <!-- ================================================================
         IISDiagnostics.W3CLogAnalysis  (the outer wrapper object)
         Default: show the groups table. Format-List for the summary header.
         ================================================================ -->
    <View>
      <Name>IISDiagnostics.W3CLogAnalysis</Name>
      <ViewSelectedBy>
        <TypeName>IISDiagnostics.W3CLogAnalysis</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><Label>Generated at</Label><ScriptBlock>$_.GeneratedAt.ToString('dd/MM/yyyy HH:mm:ss')</ScriptBlock></ListItem>
              <ListItem><Label>Window start</Label><ScriptBlock>$_.StartTime.ToString('dd/MM/yyyy HH:mm:ss')</ScriptBlock></ListItem>
              <ListItem><Label>Window end</Label><ScriptBlock>$_.EndTime.ToString('dd/MM/yyyy HH:mm:ss')</ScriptBlock></ListItem>
              <ListItem><Label>Total requests</Label><PropertyName>TotalRequests</PropertyName></ListItem>
              <ListItem><Label>Status groups</Label><PropertyName>TotalGroups</PropertyName></ListItem>
              <ListItem><Label>Error groups (4xx+5xx)</Label><ScriptBlock>$_.ErrorGroups.Count</ScriptBlock></ListItem>
              <ListItem><Label>Server error groups (5xx)</Label><ScriptBlock>$_.ServerErrors.Count</ScriptBlock></ListItem>
              <ListItem><Label>Undocumented groups</Label><ScriptBlock>
                if ($_.UnknownGroups.Count -gt 0) {
                    "$($_.UnknownGroups.Count) — run Get-IISStatusHelp for each, or check the StatusCodes.json data file"
                } else { '0' }
              </ScriptBlock></ListItem>
              <ListItem>
                <Label>All groups</Label>
                <ScriptBlock>
                  ($_.Groups | ForEach-Object {
                      $title = if ($_.Title) { $_.Title } else { '(not in data file)' }
                      '{0,-11} {1,6:N0}  {2,5}%  {3}' -f $_.StatusKey, $_.Count, $_.Percent, $title
                  }) -join [Environment]::NewLine
                </ScriptBlock>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

    <!-- ================================================================
         IISDiagnostics.W3CEntry
         Default table: triage columns. Detail list via Format-List.
         ================================================================ -->
    <View>
      <Name>IISDiagnostics.W3CEntry</Name>
      <ViewSelectedBy>
        <TypeName>IISDiagnostics.W3CEntry</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Timestamp</Label><Width>21</Width><Alignment>Left</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>SC</Label><Width>4</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Sub</Label><Width>4</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>W32</Label><Width>5</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Method</Label><Width>8</Width><Alignment>Left</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>UriStem</Label><Width>42</Width><Alignment>Left</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Ms</Label><Width>8</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>ClientIp</Label><Width>16</Width><Alignment>Left</Alignment></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><ScriptBlock>if ($_.Timestamp) { $_.Timestamp.ToString('dd/MM/yyyy HH:mm:ss') } else { '-' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.StatusCode)  { $_.StatusCode  } else { '-' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($null -ne $_.SubStatus)   { $_.SubStatus   } else { '-' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($null -ne $_.Win32Status) { $_.Win32Status } else { '-' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Method)   { $_.Method   } else { '-' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.UriStem)  { $_.UriStem  } else { '-' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($null -ne $_.TimeTakenMs) { $_.TimeTakenMs } else { '-' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.ClientIp) { $_.ClientIp } else { '-' }</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>IISDiagnostics.W3CEntry.Detail</Name>
      <ViewSelectedBy>
        <TypeName>IISDiagnostics.W3CEntry</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><Label>Timestamp (local)</Label><ScriptBlock>if ($_.Timestamp) { $_.Timestamp.ToString('dd/MM/yyyy HH:mm:ss') } else { '-' }</ScriptBlock></ListItem>
              <ListItem><Label>Site log folder</Label><ScriptBlock>if ($_.SiteLogFolder) { $_.SiteLogFolder } else { '-' }</ScriptBlock></ListItem>
              <ListItem><Label>Site name (s-sitename)</Label><ScriptBlock>if ($_.SiteName) { $_.SiteName } else { '— (s-sitename not logged)' }</ScriptBlock></ListItem>
              <ListItem><Label>Method</Label><ScriptBlock>if ($_.Method) { $_.Method } else { '-' }</ScriptBlock></ListItem>
              <ListItem><Label>URI stem</Label><ScriptBlock>if ($_.UriStem) { $_.UriStem } else { '-' }</ScriptBlock></ListItem>
              <ListItem><Label>URI query</Label><ScriptBlock>if ($_.UriQuery) { $_.UriQuery } else { '-' }</ScriptBlock></ListItem>
              <ListItem><Label>HTTP version</Label><ScriptBlock>if ($_.HttpVersion) { $_.HttpVersion } else { '-' }</ScriptBlock></ListItem>
              <ListItem><Label>Status code</Label><ScriptBlock>if ($_.StatusCode) { $_.StatusCode } else { '-' }</ScriptBlock></ListItem>
              <ListItem><Label>Substatus</Label><ScriptBlock>if ($null -ne $_.SubStatus) { $_.SubStatus } else { '-' }</ScriptBlock></ListItem>
              <ListItem>
                <Label>Win32 status</Label>
                <ScriptBlock>
                  if ($null -ne $_.Win32Status) {
                      if ($_.Win32Status -eq 64) { "64 — ERROR_NETNAME_DELETED (connection reset)" }
                      elseif ($_.Win32Status -eq 0) { "0 — Success" }
                      else { $_.Win32Status }
                  } else { '-' }
                </ScriptBlock>
              </ListItem>
              <ListItem><Label>Connection reset</Label><PropertyName>IsConnectionReset</PropertyName></ListItem>
              <ListItem><Label>Time taken (ms)</Label><ScriptBlock>if ($null -ne $_.TimeTakenMs) { $_.TimeTakenMs } else { '-' }</ScriptBlock></ListItem>
              <ListItem><Label>Bytes sent</Label><ScriptBlock>if ($null -ne $_.BytesSent) { $_.BytesSent } else { '-' }</ScriptBlock></ListItem>
              <ListItem><Label>Bytes received</Label><ScriptBlock>if ($null -ne $_.BytesReceived) { $_.BytesReceived } else { '-' }</ScriptBlock></ListItem>
              <ListItem><Label>Client</Label><ScriptBlock>if ($_.ClientIp) { "$($_.ClientIp)$(if ($_.ClientPort) { ":$($_.ClientPort)" })" } else { '-' }</ScriptBlock></ListItem>
              <ListItem><Label>Server</Label><ScriptBlock>if ($_.ServerIp) { "$($_.ServerIp)$(if ($_.ServerPort) { ":$($_.ServerPort)" })" } else { '-' }</ScriptBlock></ListItem>
              <ListItem><Label>Host header</Label><ScriptBlock>if ($_.Host) { $_.Host } else { '-' }</ScriptBlock></ListItem>
              <ListItem><Label>Username</Label><ScriptBlock>if ($_.Username) { $_.Username } else { '-' }</ScriptBlock></ListItem>
              <ListItem><Label>User agent</Label><ScriptBlock>if ($_.UserAgent) { $_.UserAgent } else { '-' }</ScriptBlock></ListItem>
              <ListItem><Label>Source file</Label><PropertyName>SourceFile</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

    <!-- ================================================================
         IISDiagnostics.W3CSummary
         ================================================================ -->
    <View>
      <Name>IISDiagnostics.W3CSummary</Name>
      <ViewSelectedBy>
        <TypeName>IISDiagnostics.W3CSummary</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><Label>Window start</Label><ScriptBlock>$_.StartTime.ToString('dd/MM/yyyy HH:mm:ss')</ScriptBlock></ListItem>
              <ListItem><Label>Window end</Label><ScriptBlock>$_.EndTime.ToString('dd/MM/yyyy HH:mm:ss')</ScriptBlock></ListItem>
              <ListItem><Label>Log files scanned</Label><PropertyName>LogFilesScanned</PropertyName></ListItem>
              <ListItem><Label>Total requests</Label><PropertyName>TotalRequests</PropertyName></ListItem>
              <ListItem><Label>4xx errors</Label><PropertyName>ErrorRequests4xx</PropertyName></ListItem>
              <ListItem><Label>5xx errors</Label><PropertyName>ErrorRequests5xx</PropertyName></ListItem>
              <ListItem><Label>Error rate</Label><ScriptBlock>"$($_.ErrorRate)%"</ScriptBlock></ListItem>
              <ListItem><Label>Connection resets (win32=64)</Label><PropertyName>ConnectionResetDisplay</PropertyName></ListItem>
              <ListItem><Label>Slow requests (&gt;threshold)</Label><ScriptBlock>"$($_.SlowRequestCount) requests exceeded $($_.SlowThresholdMs)ms"</ScriptBlock></ListItem>
              <ListItem><Label>Status breakdown</Label><PropertyName>StatusBreakdownDisplay</PropertyName></ListItem>
              <ListItem><Label>Top URIs by count</Label><PropertyName>TopUrisByCountDisplay</PropertyName></ListItem>
              <ListItem><Label>Slowest requests</Label><PropertyName>SlowestRequestsDisplay</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

    <!-- ================================================================
         IISDiagnostics.SiteSummary
         Default table: one row per site — the at-a-glance overview.
         Detail list: expands notices with binding addresses.
         ================================================================ -->
    <View>
      <Name>IISDiagnostics.SiteSummary</Name>
      <ViewSelectedBy>
        <TypeName>IISDiagnostics.SiteSummary</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Site</Label><Width>26</Width><Alignment>Left</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>State</Label><Width>10</Width><Alignment>Left</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>AppPool</Label><Width>22</Width><Alignment>Left</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>HTTP</Label><Width>5</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>HTTPS</Label><Width>6</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>CertStatus</Label><Width>14</Width><Alignment>Left</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>DaysLeft</Label><Width>9</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Expiry</Label><Width>12</Width><Alignment>Left</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Notices</Label><Width>7</Width><Alignment>Right</Alignment></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>SiteName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SiteState</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.ApplicationPool) { $_.ApplicationPool } else { '-' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>HttpBindings</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>HttpsBindings</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>WorstCertStatus</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($null -ne $_.NearestExpiryDays) { $_.NearestExpiryDays } else { '-' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.NearestExpiry) { $_.NearestExpiry.ToString('dd/MM/yyyy') } else { '-' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.NoticeCount -gt 0) { $_.NoticeCount } else { '-' }</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>IISDiagnostics.SiteSummary.Detail</Name>
      <ViewSelectedBy>
        <TypeName>IISDiagnostics.SiteSummary</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><Label>Site name</Label><PropertyName>SiteName</PropertyName></ListItem>
              <ListItem><Label>Site ID</Label><PropertyName>SiteId</PropertyName></ListItem>
              <ListItem><Label>State</Label><PropertyName>SiteState</PropertyName></ListItem>
              <ListItem><Label>Application pool</Label><ScriptBlock>if ($_.ApplicationPool) { $_.ApplicationPool } else { '—' }</ScriptBlock></ListItem>
              <ListItem><Label>HTTP bindings</Label><PropertyName>HttpBindings</PropertyName></ListItem>
              <ListItem><Label>HTTPS bindings</Label><PropertyName>HttpsBindings</PropertyName></ListItem>
              <ListItem><Label>Other bindings</Label><PropertyName>OtherBindings</PropertyName></ListItem>
              <ListItem><Label>Worst cert status</Label><PropertyName>WorstCertStatus</PropertyName></ListItem>
              <ListItem>
                <Label>Nearest expiry</Label>
                <ScriptBlock>
                  if ($_.NearestExpiry) {
                      "$($_.NearestExpiry.ToString('dd/MM/yyyy')) ($($_.NearestExpiryDays) days) — $($_.NearestCertSubject)"
                  } else { '— (no HTTPS bindings with certificates)' }
                </ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Notices</Label>
                <ScriptBlock>
                  if ($_.Notices -and $_.Notices.Count -gt 0) {
                      ($_.Notices | ForEach-Object { "• [$($_.Binding)] $($_.Notice)" }) -join [Environment]::NewLine
                  } else { '—' }
                </ScriptBlock>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

    <!-- ================================================================
         IISDiagnostics.SiteBinding
         Default table: triage view — site, binding address, status, expiry.
         Detail list: everything including SANs and notices.
         ================================================================ -->
    <View>
      <Name>IISDiagnostics.SiteBinding</Name>
      <ViewSelectedBy>
        <TypeName>IISDiagnostics.SiteBinding</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Site</Label><Width>22</Width><Alignment>Left</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Proto</Label><Width>6</Width><Alignment>Left</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Address</Label><Width>34</Width><Alignment>Left</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>SNI</Label><Width>4</Width><Alignment>Left</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>ExpiryStatus</Label><Width>14</Width><Alignment>Left</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>DaysLeft</Label><Width>9</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Expiry</Label><Width>12</Width><Alignment>Left</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Wildcard</Label><Width>8</Width><Alignment>Left</Alignment></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>SiteName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Protocol</PropertyName></TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  $ip = if ($_.IPAddress) { $_.IPAddress } else { '*' }
                  $h  = if ($_.HostName)  { ":$($_.HostName)" } else { '' }
                  "$ip`:$($_.Port)$h"
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.IsSni) { 'Yes' } else { '-' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>ExpiryStatus</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($null -ne $_.DaysUntilExpiry) { $_.DaysUntilExpiry } else { '-' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.CertExpiry) { $_.CertExpiry.ToString('dd/MM/yyyy') } else { '-' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.IsWildcard) { 'Yes' } else { '-' }</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>IISDiagnostics.SiteBinding.Detail</Name>
      <ViewSelectedBy>
        <TypeName>IISDiagnostics.SiteBinding</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><Label>Site name</Label><PropertyName>SiteName</PropertyName></ListItem>
              <ListItem><Label>Site ID</Label><PropertyName>SiteId</PropertyName></ListItem>
              <ListItem><Label>Site state</Label><PropertyName>SiteState</PropertyName></ListItem>
              <ListItem><Label>Protocol</Label><PropertyName>Protocol</PropertyName></ListItem>
              <ListItem>
                <Label>IP address</Label>
                <ScriptBlock>if ($_.IPAddress) { $_.IPAddress } else { '* (all unassigned)' }</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Port</Label>
                <ScriptBlock>if ($_.Port) { $_.Port } else { '-' }</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Hostname</Label>
                <ScriptBlock>if ($_.HostName) { $_.HostName } else { '— (not set)' }</ScriptBlock>
              </ListItem>
              <ListItem><Label>SNI enabled</Label><PropertyName>IsSni</PropertyName></ListItem>
              <ListItem><Label>Central cert store</Label><PropertyName>IsCentralCertStore</PropertyName></ListItem>
              <ListItem>
                <Label>SSL flags (raw)</Label>
                <ScriptBlock>if ($null -ne $_.SslFlags) { $_.SslFlags } else { '-' }</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Cert thumbprint</Label>
                <ScriptBlock>if ($_.CertThumbprint) { $_.CertThumbprint } else { '— (none)' }</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Cert subject</Label>
                <ScriptBlock>if ($_.CertSubject) { $_.CertSubject } else { '—' }</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Cert issuer</Label>
                <ScriptBlock>if ($_.CertIssuer) { $_.CertIssuer } else { '—' }</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Cert expiry</Label>
                <ScriptBlock>
                  if ($_.CertExpiry) {
                      "$($_.CertExpiry.ToString('dd/MM/yyyy HH:mm')) ($($_.DaysUntilExpiry) days)"
                  } else { '—' }
                </ScriptBlock>
              </ListItem>
              <ListItem><Label>Expiry status</Label><PropertyName>ExpiryStatus</PropertyName></ListItem>
              <ListItem><Label>Wildcard cert</Label><PropertyName>IsWildcard</PropertyName></ListItem>
              <ListItem>
                <Label>Subject alt names</Label>
                <ScriptBlock>
                  if ($_.SubjectAltNames -and $_.SubjectAltNames.Count -gt 0) {
                      $_.SubjectAltNames -join ', '
                  } else { '— (none or not extracted)' }
                </ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Notices</Label>
                <ScriptBlock>
                  if ($_.Notices -and $_.Notices.Count -gt 0) {
                      ($_.Notices | ForEach-Object { "• $_" }) -join [Environment]::NewLine
                  } else { '—' }
                </ScriptBlock>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

    <!-- ================================================================
         IISDiagnostics.AppPoolStatus
         Default table: the six things you need at a glance during triage.
         Detail list: everything including notices and recycling config.
         ================================================================ -->
    <View>
      <Name>IISDiagnostics.AppPoolStatus</Name>
      <ViewSelectedBy>
        <TypeName>IISDiagnostics.AppPoolStatus</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Name</Label>
            <Width>28</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>State</Label>
            <Width>10</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Identity</Label>
            <Width>24</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>AccountStatus</Label>
            <Width>15</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>WPs</Label>
            <Width>4</Width>
            <Alignment>Right</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>RapidFail</Label>
            <Width>10</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Notices</Label>
            <Width>12</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Name</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>State</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($_.IdentityType -eq 'SpecificUser' -and $_.UserName) {
                      $_.UserName
                  } else {
                      $_.IdentityType
                  }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>AccountStatus</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>WorkerProcessCount</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($_.RapidFailProtectionEnabled) { 'Enabled' } else { 'Disabled' }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($_.Notices -and $_.Notices.Count -gt 0) {
                      "$($_.Notices.Count) notice(s)"
                  } else { '-' }
                </ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>IISDiagnostics.AppPoolStatus.Detail</Name>
      <ViewSelectedBy>
        <TypeName>IISDiagnostics.AppPoolStatus</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <Label>Name</Label>
                <PropertyName>Name</PropertyName>
              </ListItem>
              <ListItem>
                <Label>State</Label>
                <PropertyName>State</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Auto start</Label>
                <PropertyName>AutoStart</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Start mode</Label>
                <PropertyName>StartMode</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Pipeline mode</Label>
                <PropertyName>PipelineMode</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Runtime version</Label>
                <PropertyName>RuntimeVersion</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Queue length</Label>
                <PropertyName>QueueLength</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Identity type</Label>
                <PropertyName>IdentityType</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Username</Label>
                <ScriptBlock>if ($_.UserName) { $_.UserName } else { '— (built-in identity)' }</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Account status</Label>
                <PropertyName>AccountStatus</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Account detail</Label>
                <PropertyName>AccountStatusDetail</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Rapid-fail protection</Label>
                <ScriptBlock>
                  if ($_.RapidFailProtectionEnabled) {
                      "Enabled — max $($_.RapidFailProtectionMaxCrashes) crashes per $($_.RapidFailProtectionInterval)"
                  } else { 'Disabled' }
                </ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Worker processes</Label>
                <ScriptBlock>
                  if ($_.WorkerProcessCount -gt 0) {
                      "$($_.WorkerProcessCount) running (PID: $($_.WorkerProcessIds -join ', '))"
                  } else { '0 running' }
                </ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Recycle schedule</Label>
                <ScriptBlock>
                  $parts = @()
                  if ($_.RecycleTimeMinutes -gt 0) { $parts += "Every $($_.RecycleTimeMinutes) min" }
                  if ($_.RecycleSchedule -and $_.RecycleSchedule.Count -gt 0) { $parts += "At: $($_.RecycleSchedule -join ', ')" }
                  if ($_.RecycleMemoryKb -gt 0) { $parts += "Memory: $($_.RecycleMemoryKb) KB" }
                  if ($_.RecyclePrivateMemoryKb -gt 0) { $parts += "Private: $($_.RecyclePrivateMemoryKb) KB" }
                  if ($parts) { $parts -join ' | ' } else { 'Not configured' }
                </ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Notices</Label>
                <ScriptBlock>
                  if ($_.Notices -and $_.Notices.Count -gt 0) {
                      ($_.Notices | ForEach-Object { "• $_" }) -join [Environment]::NewLine
                  } else { '—' }
                </ScriptBlock>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

    <!-- ================================================================
         IISDiagnostics.HttpErrAnalysis
         Leads with the overall severity and window, then the findings block.
         ================================================================ -->
    <View>
      <Name>IISDiagnostics.HttpErrAnalysis</Name>
      <ViewSelectedBy>
        <TypeName>IISDiagnostics.HttpErrAnalysis</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <Label>Overall severity</Label>
                <PropertyName>OverallSeverity</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Generated at</Label>
                <ScriptBlock>$_.GeneratedAt.ToString('dd/MM/yyyy HH:mm:ss')</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Window start</Label>
                <ScriptBlock>$_.StartTime.ToString('dd/MM/yyyy HH:mm:ss')</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Window end</Label>
                <ScriptBlock>$_.EndTime.ToString('dd/MM/yyyy HH:mm:ss')</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Total HTTPERR entries</Label>
                <PropertyName>TotalEntries</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Findings</Label>
                <PropertyName>FindingsDisplay</PropertyName>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

    <!-- ================================================================
         IISDiagnostics.HttpErrFinding
         Table view for when the caller pipes $result.Findings
         ================================================================ -->
    <View>
      <Name>IISDiagnostics.HttpErrFinding</Name>
      <ViewSelectedBy>
        <TypeName>IISDiagnostics.HttpErrFinding</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Severity</Label>
            <Width>10</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Category</Label>
            <Width>22</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Title</Label>
            <Width>55</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Severity</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Category</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Title</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

  </ViewDefinitions>
</Configuration>
